# Novamind Configuration
APP_NAME=NOVAMIND
APP_TAGLINE=AI Innovation & Idea Structuring Platform
HOST=127.0.0.1
PORT=8000

# Security
SECRET_KEY=novamind-super-secret-jwt-key-for-2026-hackathon-security
DEV_OTP_AUTO_FILL=true
DEV_OTP_DEFAULT_CODE=123456

# AI Provider Settings
# 'local' works out-of-the-box offline with zero API key!
# 'gemini' connects directly to Google Gemini 2.5 Flash / Gemini 1.5 Pro
DEFAULT_AI_PROVIDER=local
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
